# COMET Airflow image: slim apache/airflow + amazon provider + comet package.

ARG AIRFLOW_VERSION
ARG PYTHON_VERSION

FROM apache/airflow:slim-${AIRFLOW_VERSION}-python${PYTHON_VERSION}

ARG AIRFLOW_VERSION
ARG S5CMD_VERSION

# Use the uv bundled with the Airflow base image.
# Cache and site-packages are on separate filesystems; copy instead of hardlinking.
ENV UV_LINK_MODE=copy

USER root
# comet uses /data as its working dir.
RUN mkdir -p /data && chown airflow:0 /data
# comet shells out to s5cmd to copy files to and from S3.
RUN curl -fsSL "https://github.com/peak/s5cmd/releases/download/v${S5CMD_VERSION}/s5cmd_${S5CMD_VERSION}_Linux-64bit.tar.gz" \
      | tar -xz -C /usr/local/bin s5cmd \
    && chmod +x /usr/local/bin/s5cmd
USER airflow

# Overlay dependencies from uv.lock onto the base image environment.
COPY --chown=airflow:0 pyproject.toml uv.lock /opt/comet/
RUN --mount=type=cache,target=/home/airflow/.cache/uv,uid=50000,gid=0 \
    uv sync --locked --active --inexact --no-install-project --no-dev \
      --extra airflow --project /opt/comet

COPY --chown=airflow:0 src /opt/comet/src
RUN --mount=type=cache,target=/home/airflow/.cache/uv,uid=50000,gid=0 \
    uv sync --locked --active --inexact --no-dev --extra airflow --project /opt/comet

# Check dependency consistency and confirm the overlay did not change Airflow's version.
RUN uv pip check \
    && python -c "import airflow; import airflow.providers.amazon; import airflow.providers.slack; assert airflow.__version__ == '${AIRFLOW_VERSION}', airflow.__version__"

# Entrypoint derives env and dispatches by role.
COPY --chown=airflow:0 docker/airflow-entrypoint.sh /opt/comet/bin/airflow-entrypoint.sh
RUN chmod +x /opt/comet/bin/airflow-entrypoint.sh
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/opt/comet/bin/airflow-entrypoint.sh"]
