ARG UV_VERSION
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

# Build arxiv-tex-extract.
FROM public.ecr.aws/amazonlinux/amazonlinux:2023 AS arxiv-builder
ARG RUST_TARGET_CPU

RUN dnf groupinstall "Development Tools" -y && \
    dnf clean all

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

ARG ARXIV_TEX_EXTRACT_REPO
ARG ARXIV_TEX_EXTRACT_SHA
RUN git init /arxiv-tex-extract && \
    cd /arxiv-tex-extract && \
    git remote add origin "${ARXIV_TEX_EXTRACT_REPO}" && \
    git fetch --depth 1 origin "${ARXIV_TEX_EXTRACT_SHA}" && \
    git checkout FETCH_HEAD
WORKDIR /arxiv-tex-extract
RUN RUSTFLAGS="-C target-cpu=${RUST_TARGET_CPU}" cargo build --release

FROM public.ecr.aws/amazonlinux/amazonlinux:2023
ARG COMET_ENRICH_VERSION
ARG COMET_ENRICH_TARGET
ARG S5CMD_VERSION
ARG DUCKDB_VERSION
ARG PYTHON_VERSION
ENV S5CMD_VERSION=${S5CMD_VERSION}
ENV DUCKDB_VERSION=${DUCKDB_VERSION}
ENV PYTHON_VERSION=${PYTHON_VERSION}

# Pull uv into image
COPY --from=uv /uv /uvx /bin/

# Cache and site-packages are on separate filesystems; copy instead of hardlinking.
ENV UV_LINK_MODE=copy

RUN dnf install -y \
    aws-cli \
    bash-completion \
    git \
    tar \
    gzip \
    wget \
    nano \
    unzip \
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-pip && \
    dnf clean all

ENV TMPDIR=/data/tmp
RUN mkdir -p ${TMPDIR}

WORKDIR /app

# Install s5cmd
RUN wget https://github.com/peak/s5cmd/releases/download/v${S5CMD_VERSION}/s5cmd_${S5CMD_VERSION}_Linux-64bit.tar.gz && \
    tar -xzf s5cmd_${S5CMD_VERSION}_Linux-64bit.tar.gz s5cmd && \
    chmod 755 s5cmd && \
    mv s5cmd /usr/local/bin/ && \
    rm s5cmd_${S5CMD_VERSION}_Linux-64bit.tar.gz

# Install duckdb.
RUN wget https://github.com/duckdb/duckdb/releases/download/v${DUCKDB_VERSION}/duckdb_cli-linux-amd64.zip && \
    unzip duckdb_cli-linux-amd64.zip && \
    chmod 755 duckdb && \
    mv duckdb /usr/local/bin/ && \
    rm duckdb_cli-linux-amd64.zip

# Copy arxiv-tex-extract from the builder stage.
COPY --from=arxiv-builder /arxiv-tex-extract/target/release/latex-extract /usr/local/bin/

# Readiness-wait entrypoint
COPY docker/batch-entrypoint.sh /usr/local/bin/comet-batch-entrypoint
RUN chmod 755 /usr/local/bin/comet-batch-entrypoint

# Sync Python dependencies
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-dev --python ${PYTHON_VERSION}

# Install the pinned comet-enrich release and Bash completions.
RUN COMET_ENRICH_ASSET="comet-enrich-${COMET_ENRICH_VERSION}-${COMET_ENRICH_TARGET}.tar.gz" && \
    COMET_ENRICH_URL="https://github.com/cometadata/comet-enrich/releases/download/${COMET_ENRICH_VERSION}/${COMET_ENRICH_ASSET}" && \
    wget "${COMET_ENRICH_URL}" && \
    wget "${COMET_ENRICH_URL}.sha256" && \
    sha256sum -c "${COMET_ENRICH_ASSET}.sha256" && \
    tar -xzf "${COMET_ENRICH_ASSET}" -C /usr/local/bin comet-enrich && \
    chmod 755 /usr/local/bin/comet-enrich && \
    mkdir -p /usr/share/bash-completion/completions && \
    comet-enrich completions bash > /usr/share/bash-completion/completions/comet-enrich && \
    comet-enrich --version && \
    rm "${COMET_ENRICH_ASSET}" "${COMET_ENRICH_ASSET}.sha256"

ENV PATH="/app/.venv/bin:$PATH"

# Install comet package
COPY src/ src/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --python ${PYTHON_VERSION}

ENTRYPOINT ["comet-batch-entrypoint"]
