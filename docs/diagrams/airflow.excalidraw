      "locked": false,
      "text": "BatchOperator lifecycle\nWorker submits and exits → triggerer polls\n→ new worker resumes the deferred task",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BatchOperator lifecycle\nWorker submits and exits → triggerer polls\n→ new worker resumes the deferred task",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "fDM3DaUc51ktC7WTbQvfW",
      "type": "text",
      "x": 1302.5450331809145,
      "y": 223.36404195155723,
      "width": 337.89061906871336,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAh",
      "roundness": null,
      "seed": 447402873,
      "version": 202,
      "versionNonce": 5473719,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790914125449,
      "link": null,
      "locked": false,
      "text": "Each worker uses the execution API; no\nRDS access. Only the Slack connection is\ninjected into workers. Service secrets\nremain with Airflow services.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each worker uses the execution API; no RDS access. Only the Slack connection is injected into workers. Service secrets remain with Airflow services.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "UOlrwcNUdUDqswxyRwsfR",
