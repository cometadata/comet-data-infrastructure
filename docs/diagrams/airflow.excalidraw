      "versionNonce": 1567078103,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790914125449,
      "link": null,
      "locked": false,
      "text": "Developer UI: localhost:8080\nSession Manager forwards into the api-\nserver Fargate task",
