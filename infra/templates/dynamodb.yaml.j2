AWSTemplateFormatVersion: '2010-09-09'
Description: 'DynamoDB tables for COMET'

Parameters:
  Env:
    Type: String

Resources:
  DatasetReleasesTable:
    Type: 'AWS::DynamoDB::Table'
    DeletionPolicy: 'Retain'
    UpdateReplacePolicy: 'Retain'
    Properties:
      TableName: !Sub 'comet-${Env}-dataset-releases'
      BillingMode: PAY_PER_REQUEST
      KeySchema:
        - AttributeName: dataset
          KeyType: HASH
        - AttributeName: release_date
          KeyType: RANGE
      AttributeDefinitions:
        - AttributeName: dataset
          AttributeType: S
        - AttributeName: release_date
          AttributeType: S

Outputs:
  DatasetReleasesTableName:
    Value: !Ref DatasetReleasesTable
  DatasetReleasesTableArn:
    Value: !GetAtt DatasetReleasesTable.Arn
