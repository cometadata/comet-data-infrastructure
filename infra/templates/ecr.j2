{%- macro lifecycle_policy() %}
      LifecyclePolicy:
        LifecyclePolicyText: |
{% filter indent(10, true) %}{% include 'includes/ecr-lifecycle-policy.json.j2' %}{% endfilter %}
{%- endmacro -%}
AWSTemplateFormatVersion: '2010-09-09'

Description: 'Elastic container registry: COMET image repos'

Parameters:
  RepositoryName:
    Type: String

Resources:
  BatchRepository:
    Type: 'AWS::ECR::Repository'
    DeletionPolicy: 'Retain'
    UpdateReplacePolicy: 'Retain'
    Properties:
      RepositoryName: !Sub '${RepositoryName}-batch'
      ImageTagMutability: 'IMMUTABLE'
      ImageScanningConfiguration:
        ScanOnPush: true
{{- lifecycle_policy() }}

  MarpleRepository:
    Type: 'AWS::ECR::Repository'
    DeletionPolicy: 'Retain'
    UpdateReplacePolicy: 'Retain'
    Properties:
      RepositoryName: !Sub '${RepositoryName}-marple'
      ImageTagMutability: 'IMMUTABLE'
      ImageScanningConfiguration:
        ScanOnPush: true
{{- lifecycle_policy() }}

  AirflowRepository:
    Type: 'AWS::ECR::Repository'
    DeletionPolicy: 'Retain'
    UpdateReplacePolicy: 'Retain'
    Properties:
      RepositoryName: !Sub '${RepositoryName}-airflow'
      ImageTagMutability: 'IMMUTABLE'
      ImageScanningConfiguration:
        ScanOnPush: true
{{- lifecycle_policy() }}

  # BuildKit layer cache pushed by CI; mutable because the cache tags are overwritten
  # on every build.
  BuildCacheRepository:
    Type: 'AWS::ECR::Repository'
    DeletionPolicy: 'Retain'
    UpdateReplacePolicy: 'Retain'
    Properties:
      RepositoryName: !Sub '${RepositoryName}-buildcache'
      ImageTagMutability: 'MUTABLE'
      LifecyclePolicy:
        LifecyclePolicyText: |
          {
            "rules": [
              {
                "rulePriority": 1,
                "description": "Expire untagged cache layers",
                "selection": {
                  "tagStatus": "untagged",
                  "countType": "imageCountMoreThan",
                  "countNumber": 1
                },
                "action": {
                  "type": "expire"
                }
              }
            ]
          }

Outputs:
  BatchRepositoryArn:
    Value: !GetAtt BatchRepository.Arn

  MarpleRepositoryArn:
    Value: !GetAtt MarpleRepository.Arn

  AirflowRepositoryArn:
    Value: !GetAtt AirflowRepository.Arn

  BuildCacheRepositoryArn:
    Value: !GetAtt BuildCacheRepository.Arn
