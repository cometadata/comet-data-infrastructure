# Versions built into the images, read by the Makefile, CI and the buildspecs.
# Versions CloudFormation deploys are under versions: in infra/config/config.yaml.
# v0.3.0 ships the 3.4.0 release candidate; next release: set AIRFLOW_VERSION=3.4.0, run make bump-airflow, then delete this line.
AIRFLOW_VERSION=3.4.0rc2
UV_VERSION=0.13.6
TRIVY_VERSION=0.76.1
DUCKDB_VERSION=2.0.0
RUST_TARGET_CPU=x86-64-v3
ARXIV_TEX_EXTRACT_REPO=https://github.com/cometadata/arxiv-tex-extract.git
ARXIV_TEX_EXTRACT_SHA=a0228388cdfa4f9e999096225940f6d932969c7c
COMET_ENRICH_VERSION=v0.5.0
COMET_ENRICH_TARGET=x86_64-v3-unknown-linux-gnu
MARPLE_REPO=https://gitlab.com/jdiprose/marple.git
# versions.opensearch in infra/config/config.yaml must be a version this Marple supports.
MARPLE_SHA=e5c9e9ca129badfc753ba1d954140d8b4da78e1f
