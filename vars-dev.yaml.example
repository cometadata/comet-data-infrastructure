# Copy to vars-dev.yaml and fill in. vars-dev.yaml is gitignored.

env: dev
region: us-east-1
template_bucket: your-comet-dev-cloudformation
codebuild_image: aws/codebuild/amazonlinux-x86_64-standard:6.0

# SSM Parameter Store path prefix for image digest parameters
# ({ssm_prefix}/{env}/images/...) and the vars-dev.yaml copy the deploy project reads.
ssm_prefix: /your-org/comet

# CodeConnections connection to GitHub (Developer Tools console -> Settings -> Connections),
# used by the build pipeline and the deploy project.
code_connection_arn: ''

# GitHub repository in owner/name form.
github_repository_id: cometadata/comet-data-infrastructure

# Metadata stack tags. The Environment and Service tags are injected by the Sceptre configs.
stack_tags:
  CodeRepo: https://github.com/cometadata/comet-data-infrastructure
  Contact: ''

# Budget and alarm thresholds.
monthly_budget_usd: 150
egress_budget_gb: 500
log_ingestion_threshold_mib_per_5_minutes: 10
s3_total_storage_threshold_gib: 1000
compute_age_hours_threshold: 16
ec2_launches_per_10_minutes_threshold: 5
fargate_worker_launches_per_10_minutes_threshold: 15

# Required and non-empty. Every address receives SNS monitoring notifications
# and budget alerts.
alert_emails:
  - alerts@example.org

# Shared network resources created outside this project.
# Format: "<stack-name>::<output-key>"
vpc_stack_output: ''
route_table_stack_output: ''
public_subnet_a_stack_output: ''

# Private subnets for Airflow services + RDS: replace with real ranges.
private_subnet_a_cidr: '10.0.0.0/24'
private_subnet_b_cidr: '10.0.1.0/24'

# Dev instance type: needs NVMe instance storage for /data
instance_type: c5ad.large

# Docker CLI plugin versions installed on the dev instance
instance_docker_compose_version: '5.4.0'
instance_docker_buildx_version: '0.35.0'

# Hour of day (0-23) and IANA time zone for the dev instance's nightly auto-shutdown
instance_shutdown_hour: 22
instance_shutdown_timezone: America/Los_Angeles

# See "DataCite credentials" in docs/setup.md.
datacite_credentials_secret_arn: ''

# See "Hugging Face publish credentials" in docs/setup.md.
hf_credentials_secret_arn: ''

# ARN of the Airflow Fernet key secret. CloudFormation does not manage this secret;
# use the default aws/secretsmanager encryption key and see "Rotating the Fernet key"
# in docs/setup.md.
fernet_secret_arn: ''

# Outputs of the two bootstrap stacks (`make bootstrap`). The boundary caps every COMET workload
# role, the runner role executes the deploy project, and CloudFormation assumes the service role to
# create environment resources. See "Deployment permissions" in docs/setup.md.
permissions_boundary_arn: ''
cloudformation_service_role_arn: ''
deployment_runner_role_arn: ''
